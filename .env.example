# Copy file này thành .env và điền giá trị thật

# Server
PORT=3000

# Danh tính cộng đồng
COMMUNITY_NAME=AI AGENTS CC
SITE_URL=https://aiagentscc.com
SEPAY_MEMO_PREFIX=AIAGENT

# Admin
ADMIN_KEY=doi-thanh-ma-bi-mat-dai-va-kho-doan
# Email nhận thư kiểm tra cấu hình email (Admin → Gửi thử)
ADMIN_EMAIL=

# Resend Email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=AI AGENTS CC <no-reply@aiagentscc.com>

# SePay Webhook (https://sepay.vn)
SEPAY_KEY=your_sepay_webhook_secret_key

# Google Sheets (ID của spreadsheet dùng polling thanh toán)
GSHEET_ID=your_google_sheet_id

# GoClaw Agent 1 ("An Lộ") — webhook soạn bản nháp lộ trình Thân-Tâm-Mệnh
# Lấy từ GoClaw Dashboard > Webhooks (kind=llm, Require HMAC tắt) — secret chỉ hiện 1 lần lúc tạo
GOCLAW_BASE_URL=
GOCLAW_WEBHOOK_SECRET=

# GoClaw Agent 2 ("Đồng hành & Thúc đẩy lối sống") — webhook nhận xét nhật ký ăn uống hằng ngày
# Tạo webhook riêng cho Agent 2 trên cùng GoClaw Dashboard (dùng chung GOCLAW_BASE_URL ở trên)
GOCLAW_AGENT2_WEBHOOK_SECRET=

# Telegram Bot (Agent 2) — tạo bot mới qua @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Google Drive (Hồ sơ ảnh — 3 ảnh dáng người + video kiểm tra ngồi-đứng)
# Service Account trần không có storage quota (không upload được file thật) nên dùng OAuth với
# 1 tài khoản Google thật thay thế. Tạo OAuth Client ID (Web application) tại Google Cloud Console
# > APIs & Services > Credentials, redirect URI = SITE_URL + /api/admin/drive-oauth/callback.
# Sau khi điền Client ID/Secret, vào Admin > Cài đặt > Google Drive để kết nối 1 lần (lấy refresh token).
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
